import torch
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
from io import StringIO

from botorch.models import SingleTaskGP
from botorch.fit import fit_gpytorch_mll
from gpytorch.mlls.exact_marginal_log_likelihood import ExactMarginalLogLikelihood

from botorch.sampling import SobolQMCNormalSampler
from botorch.utils.transforms import normalize
from botorch.acquisition.monte_carlo import qExpectedImprovement
from botorch.optim import optimize_acqf

from sklearn.metrics import r2_score, mean_squared_error

import numpy as np

from gpytorch.constraints import GreaterThan
from gpytorch.priors import GammaPrior
from gpytorch.likelihoods import GaussianLikelihood

from scipy.interpolate import RBFInterpolator


# ============================================================
# GENERAL SETTINGS
# ============================================================

torch.set_default_dtype(torch.double)

sns.set_style("whitegrid")

plt.rcParams["font.family"] = "Times New Roman"

# General font
plt.rcParams["font.size"] = 24

# Figure text
plt.rcParams["axes.titlesize"] = 20
plt.rcParams["axes.labelsize"] = 24
plt.rcParams["legend.fontsize"] = 14

# Tick labels
plt.rcParams["xtick.labelsize"] = 20
plt.rcParams["ytick.labelsize"] = 20

# Resolution
plt.rcParams["figure.dpi"] = 100
plt.rcParams["savefig.dpi"] = 300


# ============================================================
# SHARED GAMMA PRIOR
# ============================================================

LENGTHSCALE_PRIOR = GammaPrior(
    3.0,
    6.0
)


# ============================================================
# EXPERIMENTAL BOUNDS
# ============================================================

bounds = torch.tensor(
    [
        [50.0, 5.0, 15.0],
        [100.0, 15.0, 35.0]
    ],
    dtype=torch.double
)


param_names = [
    "Amplitude (%)",
    "Time (min)",
    "Ratio (1:R)"
]

output_name = "Yield"


# ============================================================
# DATA
# ============================================================

data = """Amplitude,Time,Ratio,Yield
50,5,25,27.78
100,5,25,22.32
50,15,25,30.94
50,15,23,28.19
100,15,25,24.64
50,10,15,23.09
100,10,15,22.86
50,15,35,25.45
50,10,35,24.62
100,10,35,17.28
70,5,15,11.77
70,15,15,12.6
70,5,35,14.62
70,15,35,15.6
70,10,25,17.01
70,10,25,16.88
70,10,25,16.73
"""

df = pd.read_csv(
    StringIO(data)
)


# ============================================================
# TRAINING INPUTS
# ============================================================

X_train = torch.tensor(
    df[
        [
            "Amplitude",
            "Time",
            "Ratio"
        ]
    ].values,
    dtype=torch.double
)


# ============================================================
# TRAINING OUTPUT
# ============================================================

Y_train = torch.tensor(
    df[["Yield"]].values,
    dtype=torch.double
)


# ============================================================
# NORMALIZE INPUTS
# ============================================================

X_norm = normalize(
    X_train,
    bounds=bounds
).clamp(
    1e-6,
    1 - 1e-6
)


# ============================================================
# STANDARDIZE OUTPUT
# ============================================================

Y_mean = Y_train.mean()

Y_std = Y_train.std()

Y_norm = (
    Y_train - Y_mean
) / Y_std


# ============================================================
# GAUSSIAN LIKELIHOOD
# ============================================================

likelihood = GaussianLikelihood(
    noise=torch.tensor(0.05),
    noise_constraint=GreaterThan(1e-2)
)


# ============================================================
# SINGLE-TASK GP
# ============================================================

gp = SingleTaskGP(
    X_norm,
    Y_norm,
    likelihood=likelihood
)


# ============================================================
# GAMMA LENGTH-SCALE PRIOR
# ============================================================

if hasattr(
    gp.covar_module,
    "base_kernel"
):

    gp.covar_module.base_kernel.lengthscale_prior = (
        LENGTHSCALE_PRIOR
    )

else:

    gp.covar_module.lengthscale_prior = (
        LENGTHSCALE_PRIOR
    )


# ============================================================
# EXACT MARGINAL LOG LIKELIHOOD
# ============================================================

mll = ExactMarginalLogLikelihood(
    gp.likelihood,
    gp
)


fit_gpytorch_mll(
    mll
)

gp.eval()


# ============================================================
# TRAINING POSTERIOR
# ============================================================

with torch.no_grad():

    post_train = gp.posterior(
        X_norm
    )

    Y_pred = (
        post_train.mean
        * Y_std
        + Y_mean
    )


# ============================================================
# TRAINING METRICS
# ============================================================

y_true = (
    Y_train
    .numpy()
    .flatten()
)

y_pred = (
    Y_pred
    .numpy()
    .flatten()
)


R2 = r2_score(
    y_true,
    y_pred
)


RMSE_train = np.sqrt(
    mean_squared_error(
        y_true,
        y_pred
    )
)


# ============================================================
# LEAVE-ONE-OUT CROSS VALIDATION
# ============================================================

y_pred_loo = []


for i in range(
    len(X_train)
):

    mask = torch.ones(
        len(X_train),
        dtype=torch.bool
    )

    mask[i] = False


    X_loo = X_norm[
        mask
    ]

    Y_loo = Y_norm[
        mask
    ]


    # Same likelihood as main model
    likelihood_loo = GaussianLikelihood(
        noise=torch.tensor(0.05),
        noise_constraint=GreaterThan(1e-2)
    )


    gp_loo = SingleTaskGP(
        X_loo,
        Y_loo,
        likelihood=likelihood_loo
    )


    # Same prior
    if hasattr(
        gp_loo.covar_module,
        "base_kernel"
    ):

        gp_loo.covar_module.base_kernel.lengthscale_prior = (
            LENGTHSCALE_PRIOR
        )

    else:

        gp_loo.covar_module.lengthscale_prior = (
            LENGTHSCALE_PRIOR
        )


    # LOOCV MLL
    mll_loo = ExactMarginalLogLikelihood(
        gp_loo.likelihood,
        gp_loo
    )


    fit_gpytorch_mll(
        mll_loo
    )

    gp_loo.eval()


    with torch.no_grad():

        pred = gp_loo.posterior(
            X_norm[
                i
            ].unsqueeze(0)
        ).mean


        y_pred_loo.append(
            (
                pred
                * Y_std
                + Y_mean
            ).item()
        )


# ============================================================
# LOOCV STATISTICS
# ============================================================

y_pred_loo = np.array(
    y_pred_loo
)


PRESS = np.sum(
    (
        y_true
        - y_pred_loo
    ) ** 2
)


TSS = np.sum(
    (
        y_true
        - np.mean(y_true)
    ) ** 2
)


Q2 = (
    1
    - PRESS / TSS
)


RMSE_LOOCV = np.sqrt(
    mean_squared_error(
        y_true,
        y_pred_loo
    )
)


# ============================================================
# PRINT MODEL VALIDATION
# ============================================================

print(
    "\n=============================="
)

print(
    "MODEL VALIDATION METRICS"
)

print(
    "=============================="
)

print(
    f"R²            = {R2:.4f}"
)


print(
    f"RMSE (Train)  = {RMSE_train:.4f}"
)


# ============================================================
# BAYESIAN OPTIMIZATION
# ============================================================

# Keep your original QMC sampler
sampler = SobolQMCNormalSampler(
    sample_shape=torch.Size([128])
)


# Keep qExpectedImprovement
acq_func = qExpectedImprovement(
    model=gp,
    best_f=Y_norm.max().item(),
    sampler=sampler
)


# Keep your original optimizer settings
candidate, _ = optimize_acqf(
    acq_function=acq_func,

    bounds=torch.tensor(
        [
            [0., 0., 0.],
            [1., 1., 1.]
        ],
        dtype=torch.double
    ),

    q=1,

    num_restarts=10,

    raw_samples=50
)


# ============================================================
# NORMALIZED NEXT POINT
# ============================================================

next_norm = candidate.detach()


# ============================================================
# CONVERT TO REAL EXPERIMENTAL CONDITIONS
# ============================================================

next_run = (
    bounds[0]
    + (
        bounds[1]
        - bounds[0]
    )
    * next_norm
)


next_run_np = (
    next_run
    .numpy()
    .flatten()
)


# ============================================================
# POSTERIOR AT BO CANDIDATE
# ============================================================

with torch.no_grad():

    post = gp.posterior(
        next_norm
    )


    pred_mean = (
        post.mean.item()
        * Y_std.item()
        + Y_mean.item()
    )


    pred_std = (
        post.variance.sqrt().item()
        * Y_std.item()
    )


    # Approximately 95% Gaussian posterior interval
    ci_lower = (
        pred_mean
        - 1.96 * pred_std
    )


    ci_upper = (
        pred_mean
        + 1.96 * pred_std
    )


# ============================================================
# PRINT BO RESULT
# ============================================================

print(
    "\n=============================="
)

print(
    "SUGGESTED NEXT EXPERIMENT"
)

print(
    "=============================="
)


for i, n in enumerate(
    param_names
):

    print(
        f"{n}: "
        f"{next_run_np[i]:.2f}"
    )


print(
    f"{output_name} Prediction: "
    f"{pred_mean:.2f}"
)


print(
    f"Posterior SD: "
    f"{pred_std:.2f}"
)


print(
    f"95% CI: "
    f"[{ci_lower:.2f}, {ci_upper:.2f}]"
)


# ============================================================
# GRADIENT CONFIDENCE BAND
# ============================================================

def gradient_fill(
    x,
    y1,
    y2,
    ax,
    cmap_name="Blues",
    alpha_range=(0.1, 0.4)
):

    n = len(x)

    for i in range(
        n - 1
    ):

        ax.fill_between(
            x[i:i + 2],

            y1[i:i + 2],

            y2[i:i + 2],

            color=plt.get_cmap(
                cmap_name
            )(
                (i / n) * 0.6
                + 0.2
            ),

            alpha=(
                (i / n)
                * (
                    alpha_range[1]
                    - alpha_range[0]
                )
                + alpha_range[0]
            )
        )


# ============================================================
# ORIGINAL 1D GP + qEI PLOTS
# ============================================================

for i in range(3):

    grid = torch.linspace(
        0,
        1,
        200
    )


    base = next_norm.repeat(
        200,
        1
    )


    base[:, i] = grid


    with torch.no_grad():

        post = gp.posterior(
            base
        )


        mean_grid = (
            post.mean.flatten()
            * Y_std
            + Y_mean
        )


        std_grid = (
            post.variance.sqrt().flatten()
            * Y_std
        )


        ei_grid = (
            acq_func(
                base.unsqueeze(-2)
            )
            .flatten()
            .numpy()
        )


    # --------------------------------------------------------
    # Convert normalized x to real units
    # --------------------------------------------------------

    x_real = (
        bounds[0, i]
        + (
            bounds[1, i]
            - bounds[0, i]
        )
        * grid
    )


    # ========================================================
    # GP POSTERIOR PLOT
    # ========================================================

    fig, ax = plt.subplots(
        figsize=(4, 3)
    )


    # --------------------------------------------------------
    # ±1 SD
    # --------------------------------------------------------

    gradient_fill(
        x_real,

        mean_grid
        - std_grid,

        mean_grid
        + std_grid,

        ax,

        cmap_name="Blues",

        alpha_range=(
            0.25,
            0.45
        )
    )


    # --------------------------------------------------------
    # ±2 SD
    # --------------------------------------------------------

    gradient_fill(
        x_real,

        mean_grid
        - 2 * std_grid,

        mean_grid
        + 2 * std_grid,

        ax,

        cmap_name="Blues",

        alpha_range=(
            0.15,
            0.30
        )
    )


    # --------------------------------------------------------
    # ±3 SD
    # --------------------------------------------------------

    gradient_fill(
        x_real,

        mean_grid
        - 3 * std_grid,

        mean_grid
        + 3 * std_grid,

        ax,

        cmap_name="Blues",

        alpha_range=(
            0.05,
            0.18
        )
    )


    # --------------------------------------------------------
    # GP MEAN
    # --------------------------------------------------------

    ax.plot(
        x_real,

        mean_grid,

        color="#0033A0",

        linewidth=3,

        label="GP Mean"
    )


    ax.scatter(
        X_train[
            :,
            i
        ].numpy(),

        Y_train.numpy().flatten(),

        color="black",

        s=45,

        alpha=0.35,

        label="Experimental Data"
    )


    # --------------------------------------------------------
    # BO NEXT POINT
    # --------------------------------------------------------

    ax.scatter(
        next_run_np[i],

        pred_mean,

        color="#7A0000",

        s=120,

        marker="o",

        edgecolors="black",

        linewidth=1.2,

        zorder=6,

        label="Next Point"
    )


    # --------------------------------------------------------
    # LABELS
    # --------------------------------------------------------

    ax.set_xlabel(
        param_names[i],

        fontsize=24
    )


    ax.set_ylabel(
        output_name,

        fontsize=24
    )


    # --------------------------------------------------------
    # TICKS
    # --------------------------------------------------------

    ax.tick_params(
        axis="both",

        labelsize=20
    )


    # --------------------------------------------------------
    # GRID
    # --------------------------------------------------------

    ax.grid(
        alpha=0.3
    )


    # --------------------------------------------------------
    # LEGEND
    # --------------------------------------------------------

    ax.legend(
        fontsize=12,

        frameon=True,

        loc="best"
    )


    fig.tight_layout()


    # --------------------------------------------------------
    # SAVE 300 DPI
    # --------------------------------------------------------

    clean_name = (
        param_names[i]
        .replace(" ", "_")
        .replace("(", "")
        .replace(")", "")
        .replace("%", "percent")
        .replace(":", "")
    )


    fig.savefig(
        f"GP_Posterior_{clean_name}.png",

        dpi=300,

        bbox_inches="tight"
    )


    # ========================================================
    # qEI PLOT
    # ========================================================

    fig, ax = plt.subplots(
        figsize=(4, 3)
    )


    # --------------------------------------------------------
    # qEI AREA
    # --------------------------------------------------------

    ax.fill_between(
        x_real,

        0,

        ei_grid,

        color="#FF6F61",

        alpha=0.25
    )


    # --------------------------------------------------------
    # qEI CURVE
    # --------------------------------------------------------

    ax.plot(
        x_real,

        ei_grid,

        color="#8B0000",

        linewidth=2.5,

        label="qExpected Improvement"
    )


    # --------------------------------------------------------
    # qEI AT GLOBAL BO CANDIDATE
    # --------------------------------------------------------

    selected_ei = (
        acq_func(
            next_norm.unsqueeze(0)
        )
        .item()
    )


    ax.scatter(
        next_run_np[i],

        selected_ei,

        color="#7A0000",

        s=110,

        marker="o",

        edgecolors="black",

        linewidth=1,

        zorder=5,

        label="Next Point"
    )


    # --------------------------------------------------------
    # LABELS
    # --------------------------------------------------------

    ax.set_xlabel(
        param_names[i],

        fontsize=24
    )


    ax.set_ylabel(
        "qExpected Improvement",

        fontsize=20
    )


    ax.tick_params(
        axis="both",

        labelsize=18
    )


    ax.grid(
        alpha=0.2
    )


    ax.legend(
        fontsize=12,

        frameon=True,

        loc="best"
    )


    fig.tight_layout()


    # --------------------------------------------------------
    # SAVE qEI FIGURE AT 300 DPI
    # --------------------------------------------------------

    fig.savefig(
        f"EI_{clean_name}.png",

        dpi=300,

        bbox_inches="tight"
    )


# ============================================================
# DISPLAY ORIGINAL FIGURES
# ============================================================

plt.show()


# ============================================================
# FINISHED ORIGINAL ANALYSIS
# ============================================================

print(
    "\nBayesian Optimization Finished!"
)

print(
    "Figures saved at 300 DPI."
)


# ============================================================
# ============================================================
# 4-PANEL BAYESIAN OPTIMIZATION RESPONSE-SURFACE FIGURE
# ============================================================
#
# X-axis = Amplitude
# Y-axis = Time
#
# Ratio is fixed at the BO-suggested value.
#
# Panels:
# 1. Mean prediction
# 2. True function / experimental response surface
# 3. Prediction uncertainty
# 4. Acquisition function
# ============================================================


# ============================================================
# GRID SETTINGS
# ============================================================

n_grid = 150


amplitude_grid = torch.linspace(
    bounds[0, 0],
    bounds[1, 0],
    n_grid
)


time_grid = torch.linspace(
    bounds[0, 1],
    bounds[1, 1],
    n_grid
)


A, T = torch.meshgrid(
    amplitude_grid,
    time_grid,
    indexing="xy"
)


# ============================================================
# FIX RATIO AT BO-SUGGESTED VALUE
# ============================================================

fixed_ratio = next_run_np[2]


# ============================================================
# CREATE 2D GRID IN REAL EXPERIMENTAL UNITS
# ============================================================

grid_real = torch.column_stack(
    [
        A.reshape(-1),

        T.reshape(-1),

        torch.full(
            (
                n_grid * n_grid,
            ),

            fixed_ratio,

            dtype=torch.double
        )
    ]
)


# ============================================================
# NORMALIZE GRID
# ============================================================

grid_norm = normalize(
    grid_real,

    bounds=bounds
).clamp(
    1e-6,
    1 - 1e-6
)


# ============================================================
# GP POSTERIOR ON 2D GRID
# ============================================================

with torch.no_grad():

    grid_posterior = gp.posterior(
        grid_norm
    )


    mean_surface = (
        grid_posterior.mean.flatten()
        * Y_std
        + Y_mean
    )


    uncertainty_surface = (
        grid_posterior.variance.sqrt().flatten()
        * Y_std
    )


# ============================================================
# qEI ON 2D GRID
# ============================================================

with torch.no_grad():

    qei_surface = (
        acq_func(
            grid_norm.unsqueeze(-2)
        )
        .flatten()
        .numpy()
    )


# ============================================================
# CONVERT GP RESULTS TO NUMPY
# ============================================================

mean_surface = (
    mean_surface
    .numpy()
    .reshape(
        n_grid,
        n_grid
    )
)


uncertainty_surface = (
    uncertainty_surface
    .numpy()
    .reshape(
        n_grid,
        n_grid
    )
)


qei_surface = (
    qei_surface
    .reshape(
        n_grid,
        n_grid
    )
)


A_np = A.numpy()

T_np = T.numpy()


# ============================================================
# EXPERIMENTAL RESPONSE SURFACE
# ============================================================
#
# Since there is no mathematical analytical true function
# supplied with the experimental dataset, the experimental
# observations are interpolated to generate the response
# surface.
#
# This represents the experimental response surface rather
# than a mathematically known ground-truth function.
# ============================================================

experimental_X = df[
    [
        "Amplitude",
        "Time"
    ]
].values


experimental_Y = df[
    "Yield"
].values


# ============================================================
# AVERAGE DUPLICATED EXPERIMENTAL CONDITIONS
# ============================================================

experimental_df = (
    df[
        [
            "Amplitude",
            "Time",
            "Yield"
        ]
    ]
    .groupby(
        [
            "Amplitude",
            "Time"
        ],
        as_index=False
    )
    .mean()
)


experimental_X_unique = (
    experimental_df[
        [
            "Amplitude",
            "Time"
        ]
    ]
    .values
)


experimental_Y_unique = (
    experimental_df[
        "Yield"
    ]
    .values
)


# ============================================================
# RBF INTERPOLATION
# ============================================================

rbf = RBFInterpolator(
    experimental_X_unique,

    experimental_Y_unique,

    kernel="thin_plate_spline",

    smoothing=0.5
)


experimental_surface = rbf(
    np.column_stack(
        [
            A_np.ravel(),

            T_np.ravel()
        ]
    )
).reshape(
    n_grid,
    n_grid
)


# ============================================================
# 4-PANEL FIGURE
# ============================================================

fig, axes = plt.subplots(
    2,
    2,

    figsize=(
        12,
        10
    )
)


# ============================================================
# PANEL 1 — MEAN PREDICTION
# ============================================================

ax = axes[0, 0]


contour1 = ax.contourf(
    A_np,

    T_np,

    mean_surface,

    levels=100,

    cmap="jet"
)


# Experimental points

ax.scatter(
    df["Amplitude"],

    df["Time"],

    c="black",

    s=45,

    edgecolors="white",

    linewidths=0.8,

    zorder=5
)


# BO suggested point

ax.scatter(
    next_run_np[0],

    next_run_np[1],

    c="white",

    s=120,

    marker="*",

    edgecolors="black",

    linewidths=1.2,

    zorder=6
)


ax.set_title(
    "Mean prediction",

    fontsize=20
)


ax.set_xlabel(
    "Amplitude (%)",

    fontsize=20
)


ax.set_ylabel(
    "Time (min)",

    fontsize=20
)


ax.tick_params(
    axis="both",

    labelsize=16
)


cbar1 = fig.colorbar(
    contour1,

    ax=ax
)


cbar1.ax.tick_params(
    labelsize=14
)


# ============================================================
# PANEL 2 — EXPERIMENTAL RESPONSE SURFACE
# ============================================================

ax = axes[0, 1]


contour2 = ax.contourf(
    A_np,

    T_np,

    experimental_surface,

    levels=100,

    cmap="jet"
)


# Experimental points

ax.scatter(
    df["Amplitude"],

    df["Time"],

    c="black",

    s=45,

    edgecolors="white",

    linewidths=0.8,

    zorder=5
)


ax.set_title(
    "True function",

    fontsize=20
)


ax.set_xlabel(
    "Amplitude (%)",

    fontsize=20
)


ax.set_ylabel(
    "Time (min)",

    fontsize=20
)


ax.tick_params(
    axis="both",

    labelsize=16
)


cbar2 = fig.colorbar(
    contour2,

    ax=ax
)


cbar2.ax.tick_params(
    labelsize=14
)


# ============================================================
# PANEL 3 — PREDICTION UNCERTAINTY
# ============================================================

ax = axes[1, 0]


contour3 = ax.contourf(
    A_np,

    T_np,

    uncertainty_surface,

    levels=100,

    cmap="jet"
)


# Experimental points

ax.scatter(
    df["Amplitude"],

    df["Time"],

    c="black",

    s=45,

    edgecolors="white",

    linewidths=0.8,

    zorder=5
)


# BO suggested point

ax.scatter(
    next_run_np[0],

    next_run_np[1],

    c="white",

    s=120,

    marker="*",

    edgecolors="black",

    linewidths=1.2,

    zorder=6
)


ax.set_title(
    "Prediction uncertainty",

    fontsize=20
)


ax.set_xlabel(
    "Amplitude (%)",

    fontsize=20
)


ax.set_ylabel(
    "Time (min)",

    fontsize=20
)


ax.tick_params(
    axis="both",

    labelsize=16
)


cbar3 = fig.colorbar(
    contour3,

    ax=ax
)


cbar3.ax.tick_params(
    labelsize=14
)


# ============================================================
# PANEL 4 — ACQUISITION FUNCTION
# ============================================================

ax = axes[1, 1]


contour4 = ax.contourf(
    A_np,

    T_np,

    qei_surface,

    levels=100,

    cmap="jet"
)


# Experimental points

ax.scatter(
    df["Amplitude"],

    df["Time"],

    c="black",

    s=45,

    edgecolors="white",

    linewidths=0.8,

    zorder=5
)


# BO suggested point

ax.scatter(
    next_run_np[0],

    next_run_np[1],

    c="white",

    s=120,

    marker="*",

    edgecolors="black",

    linewidths=1.2,

    zorder=6
)


ax.set_title(
    "Acquisition function",

    fontsize=20
)


ax.set_xlabel(
    "Amplitude (%)",

    fontsize=20
)


ax.set_ylabel(
    "Time (min)",

    fontsize=20
)


ax.tick_params(
    axis="both",

    labelsize=16
)


cbar4 = fig.colorbar(
    contour4,

    ax=ax
)


cbar4.ax.tick_params(
    labelsize=14
)


# ============================================================
# OVERALL TITLE
# ============================================================

fig.suptitle(
    f"Bayesian Optimization Surface "
    f"(Ratio = {fixed_ratio:.2f})",

    fontsize=22,

    y=0.995
)


# ============================================================
# LAYOUT
# ============================================================

fig.tight_layout(
    rect=[
        0,
        0,
        1,
        0.97
    ]
)


# ============================================================
# SAVE 4-PANEL FIGURE
# ============================================================

fig.savefig(
    "BO_4_Panel_Response_Surface.png",

    dpi=300,

    bbox_inches="tight"
)


# ============================================================
# DISPLAY 4-PANEL FIGURE
# ============================================================

plt.show()


# ============================================================
# FINAL MESSAGE
# ============================================================

print(
    "\n4-panel Bayesian Optimization figure generated!"
)

print(
    "Saved as: BO_4_Panel_Response_Surface.png"
)

print(
    "Resolution: 300 DPI"
)
